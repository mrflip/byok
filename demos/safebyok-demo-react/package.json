{
  "name": "safebyok-demo-react",
  "private": true,
  "version": "0.0.0",
  "description": "Single-page React playground for the safebyok interface: a stub vault, a fake sign-in, and an inspector showing what lands where. Never published.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "build:deps": "pnpm --filter 'safebyok-demo-react^...' build",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "pnpm build:deps",
    "test": "vitest run",
    "pretest": "pnpm build:deps",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "pnpm build:deps",
    "justify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "safebyok": "workspace:*",
    "safebyok-react": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
