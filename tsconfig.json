{
  // The workspace root's own tooling, run under Node: scripts/, their tests, the root's configs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts",
    "tests",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "coverage"
  ]
}
