{
  // The workspace root's own tooling, run under Node: scripts/, their tests, the root's configs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    // The root's scripts run under Node, which needs the `.ts` on one script's import of another.
    // Root only: the packages extend tsconfig.base.json, not this file, and never import that way.
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts",
    "tests",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "coverage"
  ]
}
