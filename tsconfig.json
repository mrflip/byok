{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // The root's own scripts run under node, which needs the `.ts` on a relative import. Root
    // only: no package extends this file, and a package's build must not import that way.
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts",
    "tests",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "coverage"
  ]
}
