{
  "name": "safebyok-convex",
  "private": true,
  "version": "0.0.0",
  "description": "Convex storage for safebyok: a Convex component holding vault bundles and lockboxes as ciphertext, and the VaultDB adapter that speaks to it. Workspace package in design; not yet published.",
  "type": "module",
  "scripts": {
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "justify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "safebyok": "workspace:*"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "convex": "^1.46.0",
    "convex-test": "^0.0.61",
    "eslint": "^10.12.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "convex": "^1.46.0"
  }
}
