{
  "name": "safebyok-convex",
  "private": true,
  "version": "0.0.0",
  "description": "Convex storage for safebyok: a Convex component holding vault bundles and lockboxes as ciphertext, and the VaultDB adapter that speaks to it. Source-exported workspace package while the interface settles; not yet built or published.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./convex.config": "./src/component/convex.config.ts",
    "./convex.config.js": "./src/component/convex.config.ts",
    "./_generated/component.js": "./src/component-api.ts",
    "./server": "./src/server.ts",
    "./test": "./src/test.ts"
  },
  "scripts": {
    "lint": "eslint --cache --cache-strategy content --cache-location .eslintcache .",
    "build:deps": "pnpm --filter 'safebyok-convex^...' build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest": "pnpm build:deps",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "pnpm build:deps",
    "justify": "pnpm install && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "convex": "^1.46.0",
    "convex-test": "^0.0.61",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-chai-expect": "^4.1.1",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "safebyok": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "convex": "^1.46.0",
    "safebyok": "workspace:^"
  }
}
