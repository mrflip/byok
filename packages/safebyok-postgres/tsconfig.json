{
  // The Postgres adapter: platform-neutral src/, which runs on the host's server (Node, Bun, Deno,
  // an edge runtime) and touches nothing of any one of them; tests and configs run under Node,
  // with PGlite as the database. eslint keeps Node's modules and globals out of src/. The DOM lib
  // is for the core, whose source the workspace reads: its WebCrypto types are the DOM's.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
